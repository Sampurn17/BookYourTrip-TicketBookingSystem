# ==============================================================================
# BookYourTrip - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# 1. Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
SERVE_CLIENT=false

# 2. Database (MongoDB Atlas replica set recommended)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookyourtrip?retryWrites=true&w=majority
MONGO_TRANSACTIONS=auto

# 3. Authentication & Security
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d

# 4. AI Travel Assistant (OpenAI or OpenAI-compatible endpoint)
# Leave OPENAI_API_KEY empty to run in offline/rule-based mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AGENT_MAX_STEPS=5

# 5. Rate Limiting
DISABLE_RATE_LIMIT=false
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AGENT_MAX=30

# 6. Business Logic Rules
APP_TZ_OFFSET=+05:30
BOOKING_WINDOW_DAYS=60
BOOKING_CUTOFF_MINUTES=30
RESCHEDULE_CUTOFF_HOURS=2
MAX_SEATS_PER_BOOKING=6

# 7. Frontend Client Configuration (Vite)
VITE_API_URL=

# 8. Benchmark / Test Scripts
BASE_URL=http://localhost:5000
USERS=100
BOOKINGS=300
CONCURRENCY=25
ADMIN_EMAIL=admin@bookyourtrip.com
ADMIN_PASSWORD=Admin@123
RACERS=50
