NODE_ENV=development
PORT=5000

# MongoDB Atlas (replica set => multi-document transactions are used automatically)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/bookyourtrip

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list, or * for any origin
CORS_ORIGIN=http://localhost:5173

# Serve the built React app (client/dist) from this server (single EC2 deployment)
SERVE_CLIENT=false

# --- Business rules ---
BOOKING_WINDOW_DAYS=60
BOOKING_CUTOFF_MINUTES=30
MAX_SEATS_PER_BOOKING=6

# Set to true while running scripts/loadTest.js from a single machine
DISABLE_RATE_LIMIT=false
